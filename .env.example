# Copia este archivo a .env y rellena tus credenciales

# --- Spotify (obligatorio) ---
# Crea una app en https://developer.spotify.com/dashboard
# Redirect URI que debes registrar en la app: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=tu_client_id_aqui

# --- Last.fm (opcional, para el motor Last.fm) ---
# Consigue una API key gratuita en https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Tu nombre de usuario de Last.fm
LASTFM_USERNAME=

# --- stats.fm (opcional, para el motor stats.fm) ---
# Tu nombre de usuario de stats.fm (el perfil debe ser público)
STATSFM_USERNAME=

# Puerto local de la app
PORT=8888
